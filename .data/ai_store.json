  "tools": {
    "caption-generator": {
      "id": "caption_generator",
      "name": "Caption Generator",
      "slug": "caption-generator",
      "taskType": "TEXT",
      "category": "CONTENT",
      "description": "Creates viral, platform-tailored social media captions with scroll-stopping hooks, line-breaks, and engagement CTAs.",
      "systemPrompt": "You are an elite social media ghostwriter and viral caption strategist for top global creators and brands.\nYour job is to generate 3 high-converting caption variations tailored to the chosen platform and audience.\nEach caption must feature:\n1. Hook (First 1-2 lines): Strong intrigue or pattern interrupt that prevents scrolling.\n2. Value Core: 2-4 punchy, spaced bullet points delivering tangible insight.\n3. Call to Action (CTA): Explicit engagement question or prompt.\n4. Curated Hashtags: 3-5 relevant, non-spammy tags.\nFormat clearly with line-breaks. Tone should precisely reflect the user's requested tone.",
      "defaultModel": "gpt-4o",
      "creditCost": 1,
      "creditType": "TEXT_GENERATION",
      "isEnabled": true,
      "iconName": "MessageSquareText",
      "displayOrder": 1
    },
    "hashtag-generator": {
      "id": "hashtag_generator",
      "name": "Hashtag Generator",
      "slug": "hashtag-generator",
      "taskType": "TEXT",
      "category": "OPTIMIZATION",
      "description": "Generates high-reach, niche-targeted, and trending hashtags segmented by discovery potential.",
      "systemPrompt": "You are an expert social media algorithm researcher.\nAnalyze the user's topic and generate a structured set of 25-30 strategic hashtags organized into 4 tiers:\n- Tier 1: Broad Category / High Volume (500k+ posts) - 6 tags\n- Tier 2: Community / Mid Volume (50k-500k posts) - 10 tags\n- Tier 3: Hyper-Niche / High Conversion (<50k posts) - 8 tags\n- Tier 4: Branded / Conversation Tags - 4 tags\nInclude a 2-sentence rationale for the recommended tag blend and platform-specific placement advice.",
      "defaultModel": "gemini-1.5-flash",
      "creditCost": 1,
      "creditType": "TEXT_GENERATION",
      "isEnabled": true,
      "iconName": "Hash",
      "displayOrder": 2
    },
    "post-ideas-generator": {
      "id": "post_ideas_generator",
      "name": "Post Ideas Generator",
      "slug": "post-ideas-generator",
      "taskType": "TEXT",
      "category": "CONTENT",
      "description": "Brainstorms 5-7 actionable, high-engagement content angles and post frameworks for brand niches.",
      "systemPrompt": "You are a creative social media director.\nGenerate 6 distinct, ready-to-execute post concepts based on the provided niche or topic.\nFor each concept provide:\n1. Concept Title & Format (e.g. Carousel, Short Video Script, Contrarian Take, Step-by-Step Breakdown)\n2. Hook Angle: The controversial or intriguing angle that sparks debate.\n3. Content Outline: 3 bullet points of what to cover.\n4. Suggested Category Bucket: Evergreen, Curated News, Behind-The-Scenes, or Promotional.",
      "defaultModel": "claude-3-5-sonnet-20241022",
      "creditCost": 1,
      "creditType": "TEXT_GENERATION",
      "isEnabled": true,
      "iconName": "Lightbulb",
      "displayOrder": 3
    },
    "content-writer": {
      "id": "content_writer",
      "name": "Content Writer",
      "slug": "content-writer",
      "taskType": "TEXT",
      "category": "CONTENT",
      "description": "Drafts long-form thought-leadership posts, LinkedIn essays, newsletter deep-dives, and detailed articles.",
      "systemPrompt": "You are a master business essayist and senior ghostwriter.\nProduce a comprehensive, deeply compelling long-form post (400-800 words) that positions the author as an undisputed domain authority.\nStructure:\n- Headline: Gripping executive title.\n- The Problem: Why the common conventional wisdom fails.\n- The Framework: A named, step-by-step mental model or operational framework.\n- Case in Point: Practical real-world example.\n- Key Takeaway: Direct summary advice.\nAvoid corporate buzzwords, passive voice, and fluffy filler.",
      "defaultModel": "claude-3-5-sonnet-20241022",
      "creditCost": 1,
      "creditType": "TEXT_GENERATION",
      "isEnabled": true,
      "iconName": "PenTool",
      "displayOrder": 4
    },
    "content-rewriter": {
      "id": "content_rewriter",
      "name": "Content Rewriter",
      "slug": "content-rewriter",
      "taskType": "TEXT",
      "category": "OPTIMIZATION",
      "description": "Polishes, simplifies, and repurposes existing drafts into punchy, high-retention social copy.",
      "systemPrompt": "You are a ruthlessly efficient social media editor.\nRewrite the provided draft text to maximize readability, retention, and viral shareability.\nRules:\n- Eliminate redundant adjectives and passive verbs.\n- Format with single-sentence paragraphs and clean whitespace.\n- Preserve all core facts and intent.\n- Deliver 2 distinct rewritten versions:\n  Version A: Punchy & Direct (Fast reading)\n  Version B: Story-Driven & Engaging (Deeper connection)",
      "defaultModel": "gpt-4o",
      "creditCost": 1,
      "creditType": "TEXT_GENERATION",
      "isEnabled": true,
      "iconName": "RefreshCw",
      "displayOrder": 5
    },
