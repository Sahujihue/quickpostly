# QuickPostly Core Application Environment Configuration
NODE_ENV="production"
APP_NAME="QuickPostly"
APP_URL="https://quickpostly.com"
PORT="3000"

# Public Brand & Canonical Domain Variables
NEXT_PUBLIC_APP_NAME="QuickPostly"
NEXT_PUBLIC_APP_URL="https://quickpostly.com"
NEXT_PUBLIC_CANONICAL_URL="https://quickpostly.com"
NEXT_PUBLIC_WWW_URL="https://www.quickpostly.com"
NEXT_PUBLIC_API_URL="https://quickpostly.com/api"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_SUPPORT_EMAIL="support@quickpostly.com"
NEXT_PUBLIC_BRAND_TAGLINE="Create Smarter. Schedule Faster. Grow Everywhere."
NEXT_PUBLIC_META_TITLE="QuickPostly – AI Social Media Management Platform"
NEXT_PUBLIC_META_DESCRIPTION="Create AI-powered social media content, schedule posts, manage multiple accounts and grow your brand with QuickPostly."

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/quickpostly_db?schema=public"

# Cache & Queues (Redis)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="replace-with-at-least-32-random-characters-in-production"
JWT_EXPIRES_IN="7d"
SESSION_COOKIE_NAME="quickpostly_session"

# Payment Gateways (Stripe, Razorpay, Cashfree, PayPal, etc.)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Multi-AI Studio Providers
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
ELEVENLABS_API_KEY=""

# Email Delivery (SMTP)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS=""
SMTP_FROM="support@quickpostly.com"
SMTP_FROM_NAME="QuickPostly"

LOG_LEVEL="info"
